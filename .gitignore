# SSH 私钥（绝对不能提交）
.ssh/id_*
.ssh/*.pem
.ssh/*.key

# GitHub CLI 安全文件
.config/gh/hosts.yml.bak

# Neovim 临时文件
.config/nvim/.git
.config/nvim/.tests
.config/nvim/doc/tags
.config/nvim/debug
.config/nvim/*.log

# opencode 依赖和锁文件
.config/opencode/node_modules/
.config/opencode/bun.lock
.config/opencode/package-lock.json

# macOS 系统文件
.DS_Store
.Trashes
.Spotlight-V100
.fseventsd

# 缓存和临时文件
.cache/
*.tmp
*.swp
*~
