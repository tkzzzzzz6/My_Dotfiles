#!/bin/bash
#
# yadm bootstrap - 新机器初始化脚本
# 用法：克隆 dotfiles 后运行 yadm bootstrap
#
set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${GREEN}[✓]${NC} $1"; }
warn()  { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[✗]${NC} $1"; }

# ============================================================
# 0. Homebrew 中国镜像源（必须在所有 brew 操作之前）
# ============================================================
export HOMEBREW_API_DOMAIN=https://mirrors.aliyun.com/homebrew/homebrew-bottles/api
export HOMEBREW_BOTTLE_DOMAIN=https://mirrors.aliyun.com/homebrew/homebrew-bottles
export HOMEBREW_BREW_GIT_REMOTE=https://mirrors.aliyun.com/homebrew/brew.git
export HOMEBREW_CORE_GIT_REMOTE=https://mirrors.aliyun.com/homebrew/homebrew-core.git
export HOMEBREW_CASK_GIT_REMOTE=https://mirrors.aliyun.com/homebrew/homebrew-cask.git
info "已配置 Homebrew 阿里云镜像源"

# ============================================================
# 1. Homebrew
# ============================================================
if ! command -v brew &>/dev/null; then
    info "安装 Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
else
    info "Homebrew 已安装，跳过"
fi

# ============================================================
# 2. 命令行工具（通过 Homebrew）
# ============================================================
BREW_PACKAGES=(
    yadm        # dotfiles 管理
    gh          # GitHub CLI
    tmux        # 终端复用
    btop        # 系统监控
    htop        # 进程监控
    lazygit     # Git TUI
    ripgrep     # 快速搜索
    fzf         # 模糊搜索
    jq          # JSON 处理
    wget        # 下载工具
    starship    # 终端提示符
    go          # Go 语言
    neovim      # 编辑器
    tree        # 目录树
)

info "安装命令行工具..."
for pkg in "${BREW_PACKAGES[@]}"; do
    if brew list "$pkg" &>/dev/null; then
        info "  $pkg 已安装"
    else
        warn "  安装 $pkg..."
        brew install "$pkg"
    fi
done

# ============================================================
# 3. Homebrew Cask（GUI 应用）
# ============================================================
BREW_CASKS=(
    ghostty     # 终端模拟器
)

info "安装 GUI 应用..."
for cask in "${BREW_CASKS[@]}"; do
    if brew list --cask "$cask" &>/dev/null; then
        info "  $cask 已安装"
    else
        warn "  安装 $cask..."
        brew install --cask "$cask"
    fi
done

# ============================================================
# 4. Oh My Zsh
# ============================================================
if [ ! -d "$HOME/.oh-my-zsh" ]; then info "安装 Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
else
    info "Oh My Zsh 已安装"
fi

# Zsh 插件
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]; then
    info "安装 zsh-autosuggestions..."
    git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
fi

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]; then
    info "安装 zsh-syntax-highlighting..."
    git clone https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
fi

# ============================================================
# 5. Python 工具链（uv）
# ============================================================
if ! command -v uv &>/dev/null; then
    info "安装 uv（Python 包管理器）..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
else
    info "uv 已安装"
fi

# ============================================================
# 6. Node.js（通过 nvm 或直接安装）
# ============================================================
if ! command -v node &>/dev/null; then
    info "安装 Node.js..."
    brew install node
else
    info "Node.js 已安装 ($(node --version))"
fi

# ============================================================
# 7. Neovim 插件（LazyVim）
# ============================================================
if [ -d "$HOME/.config/nvim" ]; then
    info "Neovim 配置已存在，安装插件..."
    nvim --headless "+Lazy! sync" +qa 2>/dev/null || warn "LazyVim 同步可能需要手动操作"
else
    warn "Neovim 配置目录不存在，请检查 yadm 是否正确恢复"
fi

# ============================================================
# 8. fzf 初始化
# ============================================================
if command -v fzf &>/dev/null; then
    info "配置 fzf 快捷键和补全..."
    "$(brew --prefix)/opt/fzf/install" --all --no-bash --no-fish 2>/dev/null || true
fi

# ============================================================
# 9. Git LFS
# ============================================================
if ! command -v git-lfs &>/dev/null; then
    info "安装 Git LFS..."
    brew install git-lfs
    git lfs install
else
    info "Git LFS 已安装"
fi

# ============================================================
# 10. Code-Stats 配置
# ============================================================
if [ ! -f "$HOME/.config/code-stats/config.toml" ]; then
    if [ -f "$HOME/.config/code-stats/secrets.env" ]; then
        info "从 secrets.env 生成 code-stats 配置..."
        source "$HOME/.config/code-stats/secrets.env"
        cat > "$HOME/.config/code-stats/config.toml" <<EOF
api_token = "$CODESTATS_API_KEY"
EOF
    else
        warn "未找到 code-stats 密钥，请手动配置："
        echo "  1. 访问 https://codestats.net 获取 API key"
        echo "  2. 创建 ~/.config/code-stats/secrets.env："
        echo "     CODESTATS_API_KEY=your_key_here"
        echo "  3. 创建 ~/.config/code-stats/config.toml："
        echo "     api_token = \"your_key_here\""
    fi
else
    info "code-stats 配置已存在"
fi

# ============================================================
# 11. SSH 密钥检查
# ============================================================
if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    warn "未找到 SSH 密钥，请手动生成："
    echo "  ssh-keygen -t ed25519 -C 'your_email@example.com'"
    echo "  gh auth login"
else
    info "SSH 密钥已存在"
fi

# ============================================================
# 12. GitHub CLI 认证
# ============================================================
if ! gh auth status &>/dev/null; then
    warn "GitHub CLI 未登录，请运行："
    echo "  gh auth login"
else
    info "GitHub CLI 已登录"
fi

# ============================================================
# 完成
# ============================================================
echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}  Bootstrap 完成！${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo "可能还需要手动操作："
echo "  1. gh auth login          — 登录 GitHub"
echo "  2. ssh-keygen             — 生成 SSH 密钥"
echo "  3. 打开 Ghostty/iTerm2    — 配置终端外观"
echo ""
