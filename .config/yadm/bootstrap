#!/bin/bash
#
# yadm bootstrap - 新机器初始化脚本（支持 macOS / Debian / Arch / Fedora）
# 用法：克隆 dotfiles 后运行 yadm bootstrap
#
set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${GREEN}[✓]${NC} $1"; }
warn()  { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[✗]${NC} $1"; }

# ============================================================
# 检测操作系统和发行版
# ============================================================
OS="$(uname -s)"
IS_MACOS=false
IS_LINUX=false
DISTRO=""       # debian / arch / fedora / unknown
PKG_INSTALL=""  # 包管理器安装命令

if [ "$OS" = "Darwin" ]; then
    IS_MACOS=true
    DISTRO="macos"
    info "检测到 macOS 系统"

elif [ "$OS" = "Linux" ]; then
    IS_LINUX=true

    if [ -f /etc/os-release ]; then
        . /etc/os-release
        case "$ID" in
            ubuntu|debian|linuxmint|pop|elementary|deepin|raspbian)
                DISTRO="debian"
                PKG_INSTALL="sudo apt install -y"
                info "检测到 Debian/Ubuntu 系统: $PRETTY_NAME"
                ;;
            arch|manjaro|endeavouros|cachyos)
                DISTRO="arch"
                PKG_INSTALL="yay -S --noconfirm"
                info "检测到 Arch Linux 系统: $PRETTY_NAME"
                ;;
            fedora|rhel|centos|rocky|alma)
                DISTRO="fedora"
                PKG_INSTALL="sudo dnf install -y"
                info "检测到 Fedora/RHEL 系统: $PRETTY_NAME"
                ;;
            *)
                DISTRO="unknown"
                warn "未知 Linux 发行版: $ID，将尝试使用 Homebrew"
                ;;
        esac
    else
        DISTRO="unknown"
        warn "无法检测发行版，将尝试使用 Homebrew"
    fi

else
    error "不支持的操作系统: $OS"
    exit 1
fi

# ============================================================
# 0. 中国镜像源配置
# ============================================================

# Homebrew 镜像（macOS 或 Linux 上使用 Homebrew 时）
export HOMEBREW_API_DOMAIN=https://mirrors.aliyun.com/homebrew/homebrew-bottles/api
export HOMEBREW_BOTTLE_DOMAIN=https://mirrors.aliyun.com/homebrew/homebrew-bottles
export HOMEBREW_BREW_GIT_REMOTE=https://mirrors.aliyun.com/homebrew/brew.git
export HOMEBREW_CORE_GIT_REMOTE=https://mirrors.aliyun.com/homebrew/homebrew-core.git
export HOMEBREW_CASK_GIT_REMOTE=https://mirrors.aliyun.com/homebrew/homebrew-cask.git

# npm 淘宝镜像
if command -v npm &>/dev/null; then
    npm config set registry https://registry.npmmirror.com
    info "已配置 npm 淘宝镜像源"
fi

# Go 模块代理（七牛）
if command -v go &>/dev/null; then
    go env -w GOPROXY=https://goproxy.cn,direct
    info "已配置 Go 七牛镜像源"
fi

# uv（pip）清华镜像
mkdir -p "$HOME/.config/uv"
cat > "$HOME/.config/uv/uv.toml" << 'UV_EOF'
default-index = "https://pypi.tuna.tsinghua.edu.cn/simple"
UV_EOF
info "已配置 uv 清华镜像源"

# Debian/Ubuntu apt 镜像（阿里云）
if [ "$DISTRO" = "debian" ]; then
    if [ ! -f /etc/apt/sources.list.d/aliyun-mirror.list ] && \
       ! grep -q "mirrors.aliyun.com" /etc/apt/sources.list 2>/dev/null; then
        info "提示：可手动配置 apt 阿里云镜像以加速下载"
        echo "  参考: https://developer.aliyun.com/mirror/"
    fi
fi

# Arch pacman 镜像（中国源排序）
if [ "$DISTRO" = "arch" ]; then
    info "提示：可手动编辑 /etc/pacman.d/mirrorlist 将中国源置顶"
fi

# ============================================================
# 1. 基础依赖安装
# ============================================================
install_pkg() {
    local pkg="$1"
    if [ "$DISTRO" = "debian" ]; then
        sudo apt install -y "$pkg"
    elif [ "$DISTRO" = "arch" ]; then
        yay -S --noconfirm "$pkg"
    elif [ "$DISTRO" = "fedora" ]; then
        sudo dnf install -y "$pkg"
    elif [ "$DISTRO" = "macos" ] || [ "$DISTRO" = "unknown" ]; then
        brew install "$pkg"
    fi
}

is_installed() {
    command -v "$1" &>/dev/null
}

# ============================================================
# 2. Homebrew（仅 macOS）
# ============================================================
if $IS_MACOS; then
    if ! is_installed brew; then
        info "安装 Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [ -f /opt/homebrew/bin/brew ]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -f /home/linuxbrew/.linuxbrew/bin/brew ]; then
            eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
        elif [ -f /usr/local/bin/brew ]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    else
        info "Homebrew 已安装"
    fi
elif [ "$DISTRO" = "unknown" ]; then
    warn "未知发行版，跳过 Homebrew。请手动安装所需工具。"
fi

# ============================================================
# 3. Arch Linux: 安装 yay（如果尚未安装）
# ============================================================
if [ "$DISTRO" = "arch" ] && ! is_installed yay; then
    info "安装 yay (AUR helper)..."
    sudo pacman -S --noconfirm git base-devel
    git clone https://aur.archlinux.org/yay.git /tmp/yay
    cd /tmp/yay && makepkg -si --noconfirm
    cd ~
    rm -rf /tmp/yay
fi

# ============================================================
# 4. 安装命令行工具
# ============================================================
TOOLS=(
    zsh
    git
    tmux
    btop
    htop
    lazygit
    ripgrep
    fzf
    jq
    wget
    curl
    tree
    neovim
    go
    nodejs
    npm
    git-lfs
)

# Debian 特有的包名映射
DEBIAN_NAMES=(
    zsh
    git
    tmux
    btop
    htop
    lazygit
    ripgrep
    fzf
    jq
    wget
    curl
    tree
    neovim
    golang-go
    nodejs
    npm
    git-lfs
)

# Arch 特有的包名映射
ARCH_NAMES=(
    zsh
    git
    tmux
    btop
    htop
    lazygit
    ripgrep
    fzf
    jq
    wget
    curl
    tree
    neovim
    go
    nodejs
    npm
    git-lfs
)

# macOS / Homebrew 包名映射
BREW_NAMES=(
    zsh
    git
    tmux
    btop
    htop
    lazygit
    ripgrep
    fzf
    jq
    wget
    curl
    tree
    neovim
    go
    node
    node
    git-lfs
)

info "安装命令行工具..."
for i in "${!TOOLS[@]}"; do
    cmd="${TOOLS[$i]}"

    # 特殊处理：nodejs 命令是 node
    if [ "$cmd" = "nodejs" ]; then
        cmd="node"
    fi

    if is_installed "$cmd"; then
        info "  $cmd 已安装"
        continue
    fi

    warn "  安装 $cmd..."
    if [ "$DISTRO" = "debian" ]; then
        sudo apt install -y "${DEBIAN_NAMES[$i]}"
    elif [ "$DISTRO" = "arch" ]; then
        yay -S --noconfirm "${ARCH_NAMES[$i]}"
    elif [ "$DISTRO" = "fedora" ]; then
        sudo dnf install -y "${TOOLS[$i]}"
    else
        brew install "${BREW_NAMES[$i]}"
    fi
done

# ============================================================
# 5. Homebrew Cask（仅 macOS）
# ============================================================
if $IS_MACOS; then
    BREW_CASKS=(
        ghostty
    )
    info "安装 macOS 应用..."
    for cask in "${BREW_CASKS[@]}"; do
        if brew list --cask "$cask" &>/dev/null; then
            info "  $cask 已安装"
        else
            warn "  安装 $cask..."
            brew install --cask "$cask"
        fi
    done
else
    info "跳过 macOS 专属应用"
fi

# ============================================================
# 6. Oh My Zsh
# ============================================================
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    info "安装 Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
else
    info "Oh My Zsh 已安装"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]; then
    info "安装 zsh-autosuggestions..."
    git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
fi

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]; then
    info "安装 zsh-syntax-highlighting..."
    git clone https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
fi

# ============================================================
# 7. Python 工具链（uv）
# ============================================================
if ! is_installed uv; then
    info "安装 uv（Python 包管理器）..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
else
    info "uv 已安装"
fi

# ============================================================
# 8. Neovim 插件（LazyVim）
# ============================================================
if [ -d "$HOME/.config/nvim" ]; then
    info "Neovim 配置已存在，安装插件..."
    nvim --headless "+Lazy! sync" +qa 2>/dev/null || warn "LazyVim 同步可能需要手动操作"
else
    warn "Neovim 配置目录不存在，请检查 yadm 是否正确恢复"
fi

# ============================================================
# 9. fzf 初始化
# ============================================================
if is_installed fzf; then
    info "配置 fzf 快捷键和补全..."
    if $IS_MACOS; then
        "$(brew --prefix)/opt/fzf/install" --all --no-bash --no-fish 2>/dev/null || true
    else
        info "  fzf 键绑定已由包管理器配置"
    fi
fi

# ============================================================
# 10. Code-Stats 配置
# ============================================================
if [ ! -f "$HOME/.config/code-stats/config.toml" ]; then
    if [ -f "$HOME/.config/code-stats/secrets.env" ]; then
        info "从 secrets.env 生成 code-stats 配置..."
        source "$HOME/.config/code-stats/secrets.env"
        cat > "$HOME/.config/code-stats/config.toml" <<EOF
api_token = "$CODESTATS_API_KEY"
EOF
    else
        warn "未找到 code-stats 密钥，请手动配置："
        echo "  1. 访问 https://codestats.net 获取 API key"
        echo "  2. 创建 ~/.config/code-stats/secrets.env："
        echo "     CODESTATS_API_KEY=your_key_here"
        echo "  3. 运行 yadm bootstrap 自动生成 config.toml"
    fi
else
    info "code-stats 配置已存在"
fi

# ============================================================
# 11. SSH 密钥检查
# ============================================================
if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    warn "未找到 SSH 密钥，请手动生成："
    echo "  ssh-keygen -t ed25519 -C 'your_email@example.com'"
else
    info "SSH 密钥已存在"
fi

# ============================================================
# 12. GitHub CLI 认证
# ============================================================
if is_installed gh; then
    if ! gh auth status &>/dev/null; then
        warn "GitHub CLI 未登录，请运行："
        echo "  gh auth login"
    else
        info "GitHub CLI 已登录"
    fi
fi

# ============================================================
# 完成
# ============================================================
echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}  Bootstrap 完成！${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo "系统: $OS ($DISTRO)"
echo "包管理器: ${PKG_INSTALL:-brew}"
echo ""
echo "可能还需要手动操作："
echo "  1. gh auth login          — 登录 GitHub"
echo "  2. ssh-keygen             — 生成 SSH 密钥"
if $IS_MACOS; then
echo "  3. 打开 Ghostty/iTerm2    — 配置终端外观"
fi
if [ "$DISTRO" = "arch" ]; then
echo "  3. 编辑 mirrorlist        — 配置 pacman 中国源"
fi
echo ""
