#!/bin/bash
#
# yadm post_clone hook
# 克隆完成后自动执行，过滤不需要出现在 $HOME 的文件
#

# 启用稀疏检出，排除仅用于仓库展示的文件
if [[ ! -f "${YADM_HOOK_REPO}/info/sparse-checkout" ]]; then
    yadm gitconfig core.sparseCheckout true
    cat << EOF > "${YADM_HOOK_REPO}/info/sparse-checkout"
# Generated by $0
/*
!README.md
!UNLICENSE
EOF
    yadm checkout --quiet
fi
